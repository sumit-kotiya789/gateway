# Copy to .env for local dev. Never commit .env. Production secrets come from the secret manager, not files.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
TRUST_PROXY_HOPS=0

# docker compose (dev only)
POSTGRES_PASSWORD=change-me-dev-only
APP_DB_PASSWORD=change-me-dev-only-app
REDIS_PASSWORD=change-me-dev-only

# App connects as the non-owner role; migrations run as the owner.
DATABASE_URL=postgres://gateway_app:change-me-dev-only-app@localhost:5432/gateway
DATABASE_MIGRATION_URL=postgres://gateway:change-me-dev-only@localhost:5432/gateway
REDIS_URL=redis://:change-me-dev-only@localhost:6379

# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
ADMIN_JWT_SECRET=
API_KEY_PEPPER=
DATA_KEK=
DATA_KEK_ID=local-1

# Dashboard and admin console are served same-origin with the API path they call (reverse proxy).
# 5173 = `pnpm --filter @gw/dashboard dev`, 8080 = compose `dashboard` service
# 5174 = `pnpm --filter @gw/admin dev`, 8081 = compose `admin` service (console at /admin/)
DASHBOARD_ORIGINS=http://localhost:5173,http://localhost:8080
ADMIN_ORIGINS=http://localhost:5174,http://localhost:8081
ADMIN_IP_ALLOWLIST=

# Public origin of the api: checkout and payment-link URLs are built from it (https in production)
PUBLIC_BASE_URL=http://localhost:3000

# Email (M10). docker compose sends to Mailpit (http://localhost:8025) by itself; this is for `pnpm dev` on the host.
# Production: a real SMTP relay (smtps://user:pass@host:465) is required.
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Gateway <no-reply@localhost>
# Links in emails (verification, password reset) point here; must be one of DASHBOARD_ORIGINS.
DASHBOARD_URL=http://localhost:8080

SIGNUP_ENABLED=true
FEATURE_CUSTODIAL=false
# Wallet-address merchants (D-097): each invoice gets a CREATE2 forwarder that pays the merchant's payout address,
# fee split on-chain. Needs the signer (gas wallet) and a factory per chain (pnpm forwarder:deploy). Off by default.
FEATURE_FORWARDER=false
# Bearer token for GET /metrics (Prometheus; >= 32 chars). Empty = no metrics route.
METRICS_TOKEN=
# true only to deliver webhooks to local/private receivers in development (refused in production)
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
# true = admin console login with email + password only, no authenticator code (local testing; refused in
# production). Step-up actions (kill switches, withdrawal approvals, ...) still ask for a code.
ADMIN_LOGIN_TOTP_DISABLED=false

# Host ports (change if taken locally)
PG_HOST_PORT=5432
REDIS_HOST_PORT=6379
DASHBOARD_HOST_PORT=8080
ADMIN_HOST_PORT=8081

# Chain RPC (registry rows reference these as ${NAME}; a chain with an unset placeholder fails chains:verify and is
# not scanned). The first URL must serve address-filtered eth_getLogs: the public bnbchain.org dataseed nodes refuse it.
# publicnode works; a dedicated provider (NodeReal, Ankr, QuickNode, ...) is more reliable.
BSC_RPC_URL=https://bsc-rpc.publicnode.com
BSC_TESTNET_RPC_URL=https://bsc-testnet.publicnode.com
# sastaUSDT, our mock USDT on BSC testnet (no official testnet USDT exists): `pnpm testnet:token deploy` prints it.
BSC_TESTNET_USDT_ADDRESS=
# Private key of a throwaway BSC testnet wallet that deploys and mints sastaUSDT (fund it with faucet tBNB).
# Testnet only: never a key that holds real funds. Read by `pnpm testnet:token` on the host; never passed to containers.
BSC_TESTNET_DEPLOYER_KEY=
# ForwarderFactory per chain (D-097), set once: pnpm forwarder:deploy prints the testnet one. Mainnet only after the audit.
BSC_TESTNET_FORWARDER_FACTORY=
BSC_FORWARDER_FACTORY=
# Optional local Anvil chain: set EVM_LOCAL_RPC_URL=http://localhost:8545 and run `docker compose --profile anvil up`.
EVM_LOCAL_RPC_URL=
EVM_LOCAL_USDT_ADDRESS=

# Signer (custodial only, M7; separate process and deployment: `pnpm --filter @gw/signer dev`).
# Dev/test seed: `pnpm -s --filter @gw/signer init-seed > custody.json` creates SIGNER_SEED_FILE and prints what to register.
# Production requires mTLS and takes the KEK only from SIGNER_SEED_KEK_FILE (secret-manager file on tmpfs; no KMS, D-010).
SIGNER_DATABASE_URL=postgres://gateway_signer:change-me-dev-only-signer@localhost:5432/gateway
# docker compose (profile `custodial`): the signer's DB password; the postgres init creates its login on a fresh volume.
SIGNER_DB_PASSWORD=change-me-dev-only-signer
SIGNER_HMAC_SECRET=
SIGNER_SEED_FILE=./signer-seed.json
SIGNER_SEED_KEK=
# SIGNER_SEED_KEK_FILE=/run/secrets/signer_seed_kek
# Per-token limits for payouts out of the hot wallet, token units: {"bsc:usdt":{"per_tx":"5000","per_day":"20000"}}
SIGNER_LIMITS={}
SIGNER_COLD_ADDRESSES=
# Hot wallet policy (D-105): sign automatic hot -> cold transfers for the excess over the cap an admin sets (admin
# console > Custody > Hot wallet limits). Off by default; they can only reach SIGNER_COLD_ADDRESSES.
SIGNER_AUTO_TO_COLD=false
SIGNER_MAX_GAS_PRICE_GWEI=20
SIGNER_MAX_GAS_TOPUP=0.005
# Forwarder flushes (D-097): the gas wallet pays; at most this many per 24 h, each at most this much gas.
SIGNER_MAX_FORWARDS_PER_DAY=10000
SIGNER_MAX_FORWARD_GAS=1500000

# Public site (D-102): where its buttons point, baked in at build time.
WEBSITE_DASHBOARD_URL=http://localhost:8080
WEBSITE_DEMO_URL=http://localhost:8083
# Demo web3 app (compose profile `demo`, D-102): a TEST secret key (read, invoices:write, payouts:write) of the merchant
# the demo runs as, and the secret of a webhook endpoint pointing at http://demo:8083/webhooks/gateway (local runs need
# WEBHOOK_ALLOW_PRIVATE_NETWORKS=true). Without the webhook secret the demo syncs deposits on page load instead.
DEMO_API_KEY=
DEMO_WEBHOOK_SECRET=
