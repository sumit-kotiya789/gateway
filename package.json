{
  "name": "gateway",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @gw/server dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit": "pnpm audit --audit-level=high",
    "migrate": "pnpm --filter @gw/server migrate",
    "admin:create": "pnpm --filter @gw/server admin:create",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "contracts:build": "docker run --rm -v \"$PWD/contracts:/c\" -w /c ghcr.io/foundry-rs/foundry:stable \"forge build\" && node scripts/export-contract-artifacts.mjs",
    "db:seed": "pnpm --filter @gw/server db:seed",
    "chains:verify": "pnpm --filter @gw/server chains:verify",
    "platform:register": "pnpm --filter @gw/server platform:register"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
