{
  "name": "@gw/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main-api.ts",
    "build": "esbuild src/main-api.ts --bundle --platform=node --target=node22 --format=cjs --sourcemap --outfile=dist/api.cjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@gw/core": "workspace:*",
    "fastify": "5.12.7",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "tsx": "4.23.15"
  }
}
